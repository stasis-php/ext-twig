{
    "name": "stasis/ext-twig",
    "description": "Twig extension for Stasis",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stasis-php/ext-twig",
    "authors": [
        {
            "name": "Volodymyr Stelmakh",
            "homepage": "https://github.com/vstelmakh"
        }
    ],
    "require": {
        "php": "^8.4",
        "stasis/stasis": "^0.2.0",
        "twig/twig": "^3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13",
        "symfony/process": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Stasis\\Extension\\Twig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stasis\\Extension\\Twig\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
